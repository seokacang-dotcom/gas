$success = 0;
$fail = 0;

if (count($brands) < count($paths)) {
    die("<div class='log'>
            <span>❌ Brand kurang dari jumlah path!</span>
            <span class='badge fail'>ERROR</span>
          </div>");
}

foreach ($paths as $index => $path) {

    $path = trim($path);
    
    // Bersihkan path dari ekstensi apapun di akhir
    $path = preg_replace('/\.(php|html?|png|jpg|gif|css|js|txt)$/i', '', $path);
    
    // HAPUS trailing slash jika ada
    $path = rtrim($path, '/');
    
    echo "<div class='log'>
            <span>📁 Processing: $path</span>
            <span class='badge info'>INFO</span>
          </div>";
    
    // Pisahkan path menjadi bagian-bagian
    $parts = explode('/', $path);
    
    // Ambil nama file (bagian terakhir)
    $fileName = array_pop($parts);
    
    // Sisanya adalah folder path
    $folderPath = implode('/', $parts);
    
    // Build full folder path di server
    $fullFolderPath = $_SERVER['DOCUMENT_ROOT'] . '/' . $folderPath;
    
    // File output (tanpa ekstensi)
    $outputFile = $fullFolderPath . '/' . $fileName;
    
    // Buat folder recursively jika belum ada
    if (!empty($folderPath) && !is_dir($fullFolderPath)) {
        if (!mkdir($fullFolderPath, 0755, true)) {
            echo "<div class='log'>
                    <span>❌ Gagal buat folder: $fullFolderPath</span>
                    <span class='badge fail'>ERROR</span>
                  </div>";
            $fail++;
            continue;
        }
    }
    
    // URL Canonical
    $protocol = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? "https" : "http";
    $url = $protocol . "://" . $_SERVER['HTTP_HOST'] . '/' . $path;
    
    $brand = $brands[$index];
    $brandUpper = strtoupper($brand);
    
    // Proses konten
    $content = $template;
    
    // Replace semua variabel PHP dengan value static
    $content = str_replace('{{BRAND_NAME}}', $brand, $content);
    $content = str_replace('{{URL_PATH}}', $url, $content);
    
    // Bersihkan semua tag PHP
    $content = preg_replace('/<\?php\s*echo\s*strtoupper\(\s*\$brandName\s*\)\s*;\s*\?>/i', $brandUpper, $content);
    $content = preg_replace('/<\?php\s*echo\s*\$urlPath\s*;?\s*\?>/i', $url, $content);
    $content = preg_replace('/<\?=\s*strtoupper\(\s*\$brandName\s*\)\s*\?>/i', $brandUpper, $content);
    $content = preg_replace('/<\?=\s*\$urlPath\s*\?>/i', $url, $content);
    $content = preg_replace('/<\?php.*?\?>/s', '', $content);
    $content = preg_replace('/<\?=.*?\?>/s', '', $content);
    
    // Tulis FILE (tanpa ekstensi)
    if (file_put_contents($outputFile, $content)) {
        echo "<div class='log'>
                <span>✅ FILE: $outputFile</span>
                <span class='badge success'>SUCCESS</span>
              </div>";
        echo "<div class='log' style='border-left-color: #ffaa00; font-size: 11px;'>
                <span>🔗 URL: $url</span>
                <span class='badge info'>CANONICAL</span>
              </div>";
        $success++;
    } else {
        echo "<div class='log'>
                <span>❌ Gagal write: $outputFile</span>
                <span class='badge fail'>ERROR</span>
              </div>";
        $fail++;
    }
    
    ob_flush();
    flush();
}

