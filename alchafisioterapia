<script type="text/javascript">
(function(){
  function ready(fn){
    if(document.readyState !== 'loading') { fn(); }
    else if(document.addEventListener) { document.addEventListener('DOMContentLoaded', fn); }
    else { window.attachEvent('onload', fn); }
  }

  ready(function(){
    var providers = [
      {provider:'Pragmatic Play', games:['Gates of Olympus','Starlight Princess','Sweet Bonanza','Sugar Rush','Bonanza Gold','Wild West Gold','Madame Destiny Megaways','Aztec Gems']},
      {provider:'PG Soft', games:['Mahjong Ways','Mahjong Ways 2','Treasures of Aztec','Lucky Neko','Wild Bandito','Caishen Wins','Queen of Bounty','Leprechaun Riches']},
      {provider:'Habanero', games:['Koi Gate','Fa Cai Shen','Hot Hot Fruit','Ways of Fortune','5 Lucky Lions','Nuwa','Mystic Fortune Deluxe','Lantern Luck']},
      {provider:'Joker Gaming', games:['Roma','Lucky God Progressive','Golden Dragon','Joker Madness','Burning Pearl','Hot Fruits','Pan Jin Lian','Hercules']},
      {provider:'Spadegaming', games:['Fishing War','Brothers Kingdom','Royale House','Golden Lotus','Fiery Sevens','Kung Fu Dragon','Alien Hunter','Mega 7']}
    ];

    var box = document.getElementById('rtpGameContainer');
    var btn = document.getElementById('rtpRefreshBtn');
    var runCount = 0;

    if(!box){ return; }

    function randomRtp(provider, game){
      var base = provider.length + game.length + runCount + new Date().getSeconds() + new Date().getMinutes();
      var random = Math.abs(Math.sin(base * 9999 + Math.random() * 9999));
      return (88 + (random * 10.8)).toFixed(2);
    }

    function rtpStatus(rtp){
      rtp = parseFloat(rtp);
      if(rtp >= 96) return 'HOT';
      if(rtp >= 92) return 'GACOR';
      return 'NORMAL';
    }

    function makeCard(provider, game){
      var rtp = randomRtp(provider, game);
      var html = '';
      html += '<div class="rtp-card">';
      html += '<div class="rtp-game-name">' + game + '</div>';
      html += '<div class="rtp-provider">Provider: ' + provider + '</div>';
      html += '<div class="rtp-row"><span class="rtp-label">RTP</span><span class="rtp-value">' + rtp + '%</span></div>';
      html += '<div class="rtp-bar"><div class="rtp-fill" style="width:' + rtp + '%"></div></div>';
      html += '<span class="rtp-tag">' + rtpStatus(rtp) + '</span>';
      html += '</div>';
      return html;
    }

    function renderRtp(){
      runCount++;
      var output = '';
      for(var i=0; i<providers.length; i++){
        var group = providers[i];
        output += '<div class="rtp-provider-group">';
        output += '<h3 class="rtp-provider-title">' + group.provider + '</h3>';
        output += '<div class="rtp-game-grid">';
        for(var j=0; j<group.games.length; j++){
          output += makeCard(group.provider, group.games[j]);
        }
        output += '</div></div>';
      }
      box.innerHTML = output;
    }

    if(btn){
      btn.onclick = function(e){
        if(e && e.preventDefault){ e.preventDefault(); }
        renderRtp();
        return false;
      };
    }

    renderRtp();
    window.setInterval(renderRtp, 15000);
  });
})();
</script>
