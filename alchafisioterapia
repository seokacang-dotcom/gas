<style id="<?php echo strtoupper($brandName); ?>-live-rtp">
/* indikator RTP hidup */
.rtp-live-dot{
  display:inline-block;width:7px;height:7px;border-radius:50%;
  background:#22c55e;margin-left:6px;vertical-align:middle;
  box-shadow:0 0 0 rgba(34,197,94,.7);
  animation:rtpPulse 1.4s infinite;
}
@keyframes rtpPulse{
  0%{box-shadow:0 0 0 0 rgba(34,197,94,.7)}
  70%{box-shadow:0 0 0 7px rgba(34,197,94,0)}
  100%{box-shadow:0 0 0 0 rgba(34,197,94,0)}
}
.rtp-live-updated{transition:opacity .2s ease}
</style>

<script id="<?php echo strtoupper($brandName); ?>-live-rtp-script">
(function(){
  function clamp(v,min,max){ return Math.min(max,Math.max(min,v)); }

  function findRtpNodes(){
    var all = Array.from(document.querySelectorAll('body *'));
    return all.filter(function(el){
      if(el.children.length) return false;
      var t=(el.textContent||'').trim();
      return /^\d{2}(?:\.\d{1,2})?%$/.test(t);
    });
  }

  function updateRtp(){
    var nodes=findRtpNodes();
    nodes.forEach(function(el){
      var current=parseFloat(el.textContent);
      if(!isFinite(current)) return;

      // Gerakan kecil supaya terlihat live, tetap dalam rentang wajar tampilan.
      var delta=(Math.random()*1.20)-0.60;
      var next=clamp(current+delta,88.00,99.00);

      el.classList.add('rtp-live-updated');
      el.style.opacity='.45';
      setTimeout(function(){
        el.textContent=next.toFixed(2)+'%';
        el.style.opacity='1';

        // Jika progress bar ada di kartu yang sama, sinkronkan lebarnya.
        var card=el.closest('div,article,li');
        if(card){
          var bars=card.querySelectorAll('[style*="width"]');
          bars.forEach(function(bar){
            var st=bar.getAttribute('style')||'';
            if(/width\s*:\s*\d+(?:\.\d+)?%/i.test(st)){
              bar.style.width=next+'%';
            }
          });
        }
      },180);
    });

    // tanda LIVE di heading yang mengandung RTP
    document.querySelectorAll('h1,h2,h3,h4,strong').forEach(function(h){
      if(/\bRTP\b/i.test(h.textContent) && !h.querySelector('.rtp-live-dot')){
        var dot=document.createElement('span');
        dot.className='rtp-live-dot';
        dot.title='RTP live';
        h.appendChild(dot);
      }
    });
  }

  function start(){
    updateRtp();
    // berubah setiap 5 detik
    setInterval(updateRtp,5000);
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',start);
  }else{
    start();
  }
})();
</script>

