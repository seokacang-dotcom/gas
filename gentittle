$success = 0;
$fail = 0;

// Cek apakah jumlah brand dan tema cukup
if (count($brands) < count($paths) || count($temas) < count($paths)) {
    echo "<div class='log'>
            <span>Jumlah Brand atau Tema kurang dari jumlah Path!</span>
            <span class='badge fail'>ERROR</span>
          </div>";
    exit;
}

foreach ($paths as $index => $path) {

    $path = '/' . ltrim(trim($path), '/');

    $brand = isset($brands[$index]) ? $brands[$index] : '';
    $tema = isset($temas[$index]) ? $temas[$index] : ''; // <-- Ambil tema berdasarkan index

    echo "<div class='log'>
            <span>Processing: " . htmlspecialchars($path) . " (Brand: $brand, Tema: $tema)</span>
            <span class='badge info'>INFO</span>
          </div>";

    if (preg_match('/\.(php|html|htm)$/i', $path)) {

        $output = $_SERVER['DOCUMENT_ROOT'] . $path;
        $dir = dirname($output);

        if (!is_dir($dir)) {
            if (!mkdir($dir, 0755, true)) {
                echo "<div class='log'>
                        <span>Failed to create directory</span>
                        <span class='badge fail'>ERROR</span>
                      </div>";
                $fail++;
                continue;
            }
        }

        $ext = pathinfo($output, PATHINFO_EXTENSION);

        $protocol = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
        $url = $protocol . '://' . $_SERVER['HTTP_HOST'] . $path;

    } else {

        $cleanPath = '/' . trim($path, '/');
        $serverPath = $_SERVER['DOCUMENT_ROOT'] . $cleanPath;

        if (!is_dir($serverPath)) {
            if (!mkdir($serverPath, 0755, true)) {
                echo "<div class='log'>
                        <span>Failed to create directory</span>
                        <span class='badge fail'>ERROR</span>
                      </div>";
                $fail++;
                continue;
            }
        }

        $ext = $extList[array_rand($extList)];
        $output = $serverPath . '/index.' . $ext;

        $protocol = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
        $url = $protocol . '://' . $_SERVER['HTTP_HOST'] . $cleanPath . '/';
    }

    $content = $template;

    // Ganti semua placeholder
    $content = str_replace('{{BRAND_NAME}}', $brand, $content);
    $content = str_replace('{{URL_PATH}}', $url, $content);
    $content = str_replace('{{TEMA}}', $tema, $content); // <-- Ganti placeholder TEMA

    if ($ext !== 'php') {

        $brandUpper = strtoupper($brand);
        $temaUpper = strtoupper($tema); // <-- Bikin tema jadi uppercase juga

        $content = preg_replace(
            '/<\?php\s*echo\s*strtoupper\(\s*\$brandName\s*\)\s*;\s*\?>/i',
            $brandUpper,
            $content
        );
        
        // Ganti juga untuk tema jika ada
        $content = preg_replace(
            '/<\?php\s*echo\s*strtoupper\(\s*\$tema\s*\)\s*;\s*\?>/i',
            $temaUpper,
            $content
        );

        $content = preg_replace(
            '/<\?php\s*echo\s*\$urlPath\s*;?\s*\?>/i',
            $url,
            $content
        );

        $content = preg_replace(
            '/<\?=\s*strtoupper\(\s*\$brandName\s*\)\s*\?>/i',
            $brandUpper,
            $content
        );
        
        $content = preg_replace(
            '/<\?=\s*strtoupper\(\s*\$tema\s*\)\s*\?>/i',
            $temaUpper,
            $content
        );

        $content = preg_replace(
            '/<\?=\s*\$urlPath\s*\?>/i',
            $url,
            $content
        );

        $content = preg_replace('/<\?php.*?\?>/s', '', $content);
        $content = preg_replace('/<\?=.*?\?>/s', '', $content);
    }

    if (file_put_contents($output, $content)) {
        echo "<div class='log'>
                <span>Created: " . htmlspecialchars($output) . " (Brand: " . htmlspecialchars($brand) . ", Tema: " . htmlspecialchars($tema) . ")</span>
                <span class='badge success'>SUCCESS</span>
              </div>";
        $success++;
    } else {
        echo "<div class='log'>
                <span>Failed writing file</span>
                <span class='badge fail'>ERROR</span>
              </div>";
        $fail++;
    }

    ob_flush();
    flush();
}

