    xdm.identityMap = _satellite.getVar("AEP:xdm:identityMap"); // Add IdentityMap
    _satellite.xdm = xdm;

    if(o === true){
        // Send XDM to Edge Network
        alloy("sendEvent", { documentUnloading: true, xdm: xdm })
